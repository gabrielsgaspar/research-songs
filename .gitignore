# Folder patterns are anchored to the root, so a package folder with the same
# name (src/songs/build/, src/songs/common/data/) stays committable.
# tests/test_repo_rules.py checks both directions.

# Data and local work: never in Git (AGENTS.md, "Data").
/data/
/outputs/
/reports/
/scratch/
/overleaf/
/.local/

# Secrets
.env
.env.*
!.env.example
*.pem
*service-account*.json
*credentials*.json

# Python
__pycache__/
*.py[cod]
/.venv/
/build/
/dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors and tools
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.claude/*
!/.claude/settings.json
!/.claude/skills/
!/.claude/hooks/
